# Dev-time error log (see server.py / index.html's inline error catcher)
# - a build-phase safety net, not part of the shipped dashboard.
errors.jsonl

# Per-user dashboard state, written atomically by server.py.
dashboard-state.json
dashboard-state.json.tmp

# Per-machine pid fajl (server.py --stop), samo dok je server živ.
dashboard.pid

# Log auto-pokrenutog servera (install-autostart-mac.command).
dashboard-autostart.log
.DS_Store

# Arhivirani (ne obrisani) alati kad se "Ukloni trajno" pokrene - vidi
# handle_delete_app u server.py (31.7.2026). Per-user runtime stanje,
# isti princip kao dashboard-state.json iznad - ne dio shippovanog
# proizvoda.
_apps_archive/*
!_apps_archive/.gitkeep
